    private static void ZzAddBvar(){    /* ;WORD $$ADD_BVAR */
            /* Mコード=0x0085 */
        //*AccessPointer.b += POP_B_OF_Q;
        // #define  POP_B_OF_Q           (DROP_F,(UCHAR)POP_L)
        DataStack.Pop();//≒DROP Dataスタックから取り出して捨てる
        ap.SetUb((byte)(ap.GetUb() + DataStack.Pop()));
    }
    private static void ZzAddWvar(){    /* ;WORD $$ADD_WVAR */
            /* Mコード=0x0086 */
        //*AccessPointer.w += POP_W_OF_Q;
        // #define  POP_W_OF_Q           (DROP_F,(USHORT)POP_L)
        DataStack.Pop();//≒DROP Dataスタックから取り出して捨てる
        ap.SetUs((ushort)(ap.GetUs() + DataStack.Pop()));
    }
    private static void ZzAddDvar(){    /* ;WORD $$ADD_DVAR */
            /* Mコード=0x0087 */
        //*AccessPointer.l += POP_L_OF_Q;
        // #define  POP_L_OF_Q           (DROP_F,POP_L)
        DataStack.Pop();//≒DROP Dataスタックから取り出して捨てる
        ap.SetUl(ap.GetUl() + DataStack.Pop());
    }
    private static void ZzAddLvar(){    /* ;WORD $$ADD_LVAR */
            /* Mコード=0x0088 */
        // word64 high32;
        // ULONG  low32;
        // word64 value64;
        // typedef unsigned __int64       word64;
        // high32 = POP_L;
        // low32  = POP_L;
        // value64 = (high32<<32 | low32);
        /*	printf("$$ADD_LVARが呼ばれた AccessPointer=%08lx value64=%lld\n", AccessPointer, value64);*/
        // *AccessPointer.ll += value64;
        ulong high32 = DataStack.Pop();
        uint low32   = DataStack.Pop();
        ulong value64= high32<<32 | low32;
        ap.SetUll(ap.GetUll() + value64);
    }
