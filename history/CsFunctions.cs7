        // #define  POP_F                POP_L
        // #define  POP_B_OF_Q           (DROP_F,(UCHAR)POP_L)
        rtp.ResetStackIndex(mp.GetMCodeCurrentIndex());//returnスタックのインデックスをMCode領域の値で移動
