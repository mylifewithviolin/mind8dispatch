    /*---------------------  変数の直接書き込み  --------------------*/
    private static void ZzWriteBvar(){
            /* Mコード=0x0063 */
        //UCHAR  *varAddr;
        //varAddr = DataBase + FETCH_MCODE_LONG;
        //*varAddr = POP_B_OF_Q;

        // #define  DROP_L               DstackPointer++
        // #define  DROP_F               DROP_L
        // #define  POP_L                (*DstackPointer++)
        // #define  POP_F                POP_L
        // #define  POP_B_OF_Q           (DROP_F,(UCHAR)POP_L)
        ap.ResetDataIndex(mp.GetUl());
        DataStack.Pop();//≒DROP Dataスタックから取り出して捨てる
        ap.SetUb((byte)DataStack.Pop());
    }
    private static void ZzWriteWvar(){
            /* Mコード=0x0064 */
        // USHORT *varAddr;
        //varAddr = (USHORT *)(DataBase + FETCH_MCODE_LONG);
        //*varAddr = POP_W_OF_Q;

        // #define  DROP_L               DstackPointer++
        // #define  DROP_F               DROP_L
        // #define  POP_L                (*DstackPointer++)
        // #define  POP_F                POP_L
        // #define  POP_W_OF_Q           (DROP_F,(USHORT)POP_L)
        ap.ResetDataIndex(mp.GetUl());
        DataStack.Pop();//≒DROP Dataスタックから取り出して捨てる
        ap.SetUs((ushort)DataStack.Pop());
    }
    private static void ZzWriteDvar(){   /* ;WORD $$WRITE_DVAR */
            /* Mコード=0x0065 */
        // ULONG  *varAddr;
        // varAddr = (ULONG *)(DataBase + FETCH_MCODE_LONG);
        // *varAddr = POP_L_OF_Q;

        // #define  POP_L_OF_Q           (DROP_F,POP_L)
        ap.ResetDataIndex(mp.GetUl());
        DataStack.Pop();//≒DROP Dataスタックから取り出して捨てる
        ap.SetUl(DataStack.Pop());       
    }
